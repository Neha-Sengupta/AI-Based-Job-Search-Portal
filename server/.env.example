# Copy to server/.env and fill in. Every variable here is validated in src/config/env.js.

# development | test | production
NODE_ENV=development
PORT=4000
# The public site (CORS allowlist). Production: the Vercel URL.
APP_URL=http://localhost:3000
# Proxies between the visitor and Express (Next.js dev proxy = 1). Production: confirm in task T1.10.
TRUST_PROXY_HOPS=1
# Local MongoDB, or the Atlas connection string (secret).
MONGODB_URI=mongodb://127.0.0.1:27017/jobportal
# true on Atlas (a replica set); false for a local single-server MongoDB.
MONGODB_TRANSACTIONS=false

# Better Auth: 32+ random characters (openssl rand -base64 32). Secret.
BETTER_AUTH_SECRET=
# The URL the browser uses to reach /api/auth: the site (through the Next.js proxy).
BETTER_AUTH_URL=http://localhost:3000
# Checked on /internal/* (the scheduled job import). 32+ random characters. Secret.
INTERNAL_API_KEY=

# Job import. Production: greenhouse,lever,ashby,careers / 0 / companies.json
JOB_SOURCES=fixtures,arbeitnow,greenhouse
JOB_IMPORT_MAX_PER_SOURCE=50
JOB_COMPANIES_FILE=companies.dev.json

# AI (application answers only). Empty AI_BASE_URL turns AI off.
# Local Ollama: http://localhost:11434/v1 · Production: https://api.groq.com/openai/v1
AI_BASE_URL=
AI_API_KEY=
AI_MODEL=
AI_DAILY_LIMIT=20
